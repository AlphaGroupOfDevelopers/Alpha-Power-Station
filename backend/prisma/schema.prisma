generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_users {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("editor")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model contact_inquiries {
  id          String    @id
  name        String
  email       String
  subject     String
  message     String
  type        String    @default("general")
  status      String    @default("new")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  respondedAt DateTime?
  response    String?
}

model media_assets {
  id           String   @id
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnail    String?
  folder       String?  @default("general")
  uploadedBy   String?
  createdAt    DateTime @default(now())
}

model news_posts {
  id          String    @id
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  category    String
  author      String
  tags        String[]
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
}

model partners {
  id          String   @id
  name        String
  description String?
  logoUrl     String?
  website     String?
  category    String
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model projects {
  id               String    @id
  title            String
  description      String
  category         String
  division         String
  imageUrl         String?
  technicalDetails String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  challenges       String?
  featured         Boolean   @default(false)
  gallery          String[]
  methodology      String?
  publishedAt      DateTime?
  results          String?
  slug             String    @unique
}

model site_content {
  id        String   @id
  key       String   @unique
  value     String
  type      String   @default("text")
  section   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model student_applications {
  id              String    @id
  firstName       String
  lastName        String
  email           String    @unique
  phone           String
  university      String?
  division        String
  resume          String?
  coverLetter     String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  githubUrl       String?
  portfolioUrl    String?
  primaryInterest String?
  program         String?
  reviewNotes     String?
  reviewedAt      DateTime?
  whyApply        String?
  yearOfStudy     String?
}

model team_members {
  id        String   @id
  name      String
  role      String
  division  String
  bio       String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  email     String?
  featured  Boolean  @default(false)
  github    String?
  linkedin  String?
  order     Int      @default(0)
}

model testimonials {
  id        String   @id
  name      String
  role      String
  division  String
  content   String
  imageUrl  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
}
