generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_users {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("editor")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model contact_inquiries {
  id          String    @id @default(uuid())
  name        String
  email       String
  subject     String
  message     String
  type        String    @default("general")
  status      String    @default("new")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?
  response    String?
}

model media_assets {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnail    String?
  folder       String?  @default("general")
  uploadedBy   String?
  createdAt    DateTime @default(now())
}

model news_posts {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  category    String
  author      String
  tags        String[]
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model partners {
  id          String   @id @default(uuid())
  name        String
  description String?
  logoUrl     String?
  website     String?
  category    String
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model projects {
  id               String    @id @default(uuid())
  title            String
  description      String
  category         String
  division         String
  imageUrl         String?
  technicalDetails String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  challenges       String?
  featured         Boolean   @default(false)
  gallery          String[]
  methodology      String?
  publishedAt      DateTime?
  results          String?
  slug             String    @unique
}

model site_content {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("text")
  section   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model student_applications {
  id                 String    @id @default(uuid())
  firstName          String
  lastName           String
  email              String    @unique
  phone              String
  university         String?
  division           String
  resume             String?
  coverLetter        String?
  status             String    @default("pending")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  githubUrl          String?
  portfolioUrl       String?
  primaryInterest    String?
  program            String?
  reviewNotes        String?
  reviewedAt         DateTime?
  whyApply           String?
  yearOfStudy        String?
  expectedGraduation String?
  secondaryInterest  String?
  relevantCourses    String?
  projects           String?
  whatContribute     String?
  availability       String?
}

model team_members {
  id        String   @id @default(uuid())
  name      String
  role      String
  division  String
  bio       String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String?
  featured  Boolean  @default(false)
  github    String?
  linkedin  String?
  twitter   String?
  instagram String?
  facebook  String?
  whatsapp  String?
  website   String?
  gmail     String?
  youtube   String?
  tiktok    String?
  telegram  String?
  order     Int      @default(0)
}

model testimonials {
  id        String   @id @default(uuid())
  name      String
  role      String
  division  String
  content   String
  imageUrl  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
